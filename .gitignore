# A contributor's global ignore file can match a directory this repository owns and
# silently drop its source, so every owned tree is re-included here first. Later rules
# still win inside them. tools/gitignore.sh keeps this list in step with the tree.
!abi/**
!conformance/**
!core/**
!docs/**
!include/**
!nix/**
!sdk/**
!tools/**

.zig-cache/
zig-out/
docs/private/
sdk/ts/node_modules/
sdk/ts/dist/
sdk/ts/wasm/
.build/

# A global ignore hides every site/ directory, which would silently drop the
# documentation site. Claim it here, then hide only its own output.
!site/
!site/**
site/node_modules/
site/dist/
site/test-results/
site/playwright-report/
site/*.tsbuildinfo
